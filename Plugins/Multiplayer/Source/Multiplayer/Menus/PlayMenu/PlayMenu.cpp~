void UPlayMenu::OnJoinSessionButtonClicked()
{
	GetJoinSessionButton()->SetIsEnabled(false);
	
	HidePlayMenu();
	
	GetJoinGameMenu()->SetVisibility(ESlateVisibility::Visible);
	
	if (!IsValid(MultiplayerSubsystem))
    	return;
	MultiplayerSubsystem->FindSessions(10000);
}

